# Existing application configuration. Never commit real values.
MONGODB_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
QR_PUBLIC_ORIGIN=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP is used by the contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_EMAIL=
# Password reset, email verification, and two-factor sign-in emails use Resend.
RESEND_API_KEY=
RESEND_FROM="Smart QR <no-reply@your-domain.example>"

# Use test locally, live on a production deployment. Production rejects test mode.
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
# Full-price recurring plans created separately in each Paystack environment.
# These are Paystack plan codes (PLN_...), not prices. Prefer `npm run billing:setup plans`,
# which creates the plans and stores their codes. Manual purchases work without them.
PAYSTACK_TEST_PLAN_MONTHLY_V1=
PAYSTACK_TEST_PLAN_QUARTERLY_V1=
PAYSTACK_TEST_PLAN_BIANNUAL_V1=
PAYSTACK_TEST_PLAN_ANNUAL_V1=
PAYSTACK_LIVE_PLAN_MONTHLY_V1=
PAYSTACK_LIVE_PLAN_QUARTERLY_V1=
PAYSTACK_LIVE_PLAN_BIANNUAL_V1=
PAYSTACK_LIVE_PLAN_ANNUAL_V1=
# Enable only after Transfers is enabled on your Paystack account and sandbox tests pass.
PAYSTACK_TRANSFERS_ENABLED=false
# Generate at least 32 random characters; send as a Bearer token to the recovery endpoint.
BILLING_RECONCILE_SECRET=
# Set on Vercel so the daily cron in vercel.json can call the reconcile endpoint (32+ chars).
CRON_SECRET=
